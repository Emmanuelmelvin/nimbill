# Copy to .env.local for local development. On Vercel, add these under Project → Settings → Environment Variables.

# Required in production: random string of 32+ characters (signs sessions and sign-in challenges).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Required in production: Postgres connection string (e.g. Neon free tier).
# Leave empty locally to use the built-in embedded database in ./.data
DATABASE_URL=

# "Try it" sample invoice: payments go to this Nimiq address (use your own wallet).
DEMO_MERCHANT_ADDRESS=
# Optional: name shown on the sample invoice
DEMO_MERCHANT_NAME=
# Optional: Polygon address so the sample invoice can also be paid in USDT
DEMO_MERCHANT_EVM_ADDRESS=

# Optional overrides
# Public URL used in link previews (Open Graph). Defaults to the Vercel production domain.
# SITE_URL=https://your-domain.com
# NIMIQ_RPC_URL=https://rpc.nimiqwatch.com
# POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
# VALIDATORS_API_URL=https://validators-api-mainnet.nuxt.dev/api/v1/validators
# COINGECKO_API_KEY=
