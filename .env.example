# Copy to .env.local for local development. On Vercel, add these under Project → Settings → Environment Variables.

# Required in production: random string of 32+ characters (signs sessions and sign-in challenges).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Recommended in production: random string of 32+ characters, separate from SESSION_SECRET.
# It derives NimBill's half of every cheque key. NEVER rotate or lose it while cheques are open:
# funded cheques could no longer be cashed or cancelled. Without it, cheques use SESSION_SECRET
# instead, and then SESSION_SECRET must not be rotated while cheques are open. Each cheque
# remembers which of the two it was written with.
CHEQUE_KEY_SECRET=

# Required in production: Postgres connection string (e.g. Neon free tier).
# Leave empty locally to use the built-in embedded database in ./.data
DATABASE_URL=

# "Try it" sample invoice: payments go to this Nimiq address (use your own wallet).
DEMO_MERCHANT_ADDRESS=
# Optional: name shown on the sample invoice
DEMO_MERCHANT_NAME=
# Optional: Polygon address so the sample invoice can also be paid in USDT
DEMO_MERCHANT_EVM_ADDRESS=

# Optional overrides
# Public URL used in link previews (Open Graph). Defaults to the Vercel production domain.
# SITE_URL=https://your-domain.com
# NIMIQ_RPC_URL=https://rpc.nimiqwatch.com
# POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
# VALIDATORS_API_URL=https://validators-api-mainnet.nuxt.dev/api/v1/validators
# COINGECKO_API_KEY=

# Email: merchants who saved an email in Settings get a message when an invoice is paid.
# Sent through Resend (https://resend.com). Off until RESEND_API_KEY is set.
# RESEND_API_KEY=re_...
# Without a verified domain, Resend only delivers to the email address of your own Resend
# account (good for testing, not for other merchants). After verifying a domain in Resend,
# set the sender to an address on it and emails reach everyone:
# MAIL_FROM="NimBill <billing@your-domain.com>"

# Logging: error | warn | info | http | verbose | debug | silly (default: info in production, debug locally)
# LOG_LEVEL=

# Sentry (errors, logs, metrics, performance). Off until a DSN is set.
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
# For readable stack traces, upload source maps at build time:
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
